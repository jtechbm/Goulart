// JtechERP — schema multi-marketplace

generator client {
  provider        = "prisma-client-js"
  // Permite `relationLoadStrategy: "join"`: sem isso o Prisma resolve cada
  // include aninhado numa query separada e sequencial — caro quando o banco
  // não está ao lado da aplicação.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer) — usado em runtime serverless.
  url       = env("DATABASE_URL")
  // Conexão direta — usada só por `prisma db push`/`migrate`.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

/// Pessoa que entra no sistema. Sempre vinculada a um Client, que é o escopo
/// de tudo que ela enxerga.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  active       Boolean @default(true)

  /// Escopo de tudo que a pessoa vê. Sem ele não há tela para abrir.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions       Session[]
  passwordResets PasswordReset[]

  @@index([clientId])
}

model Session {
  id     String @id @default(cuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Lojista
// ---------------------------------------------------------------------------

/// A empresa dona das lojas. É o escopo de segurança do sistema inteiro:
/// toda consulta filtra por `clientId`.
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  document  String? // CNPJ/CPF
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  users         User[]
  customers     Customer[]
  financeries   FinanceEntry[]
  conversations Conversation[]
  settings      Settings?
  subscription  Subscription?
}

// ---------------------------------------------------------------------------
// Contas de marketplace conectadas
// ---------------------------------------------------------------------------

model Account {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  platform    String // MERCADO_LIVRE | SHOPEE | TIKTOK_SHOP
  shopName    String
  externalId  String // seller_id (ML) | shop_id (Shopee) | shop_id (TikTok)
  shopCipher  String? // TikTok Shop exige cipher por loja
  region      String? // Shopee/TikTok: BR, SG...
  status      String  @default("PENDING") // CONNECTED | EXPIRED | ERROR | PENDING
  statusNote  String?
  reputation  String?
  hasPenalty  Boolean @default(false)
  penaltyNote String?

  // Tokens OAuth (cifrados em repouso — ver src/lib/crypto.ts)
  accessToken     String?
  refreshToken    String?
  accessExpiresAt DateTime?
  refreshExpires  DateTime?

  lastSyncAt   DateTime?
  lastSyncNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders   Order[]
  metrics  DailyMetric[]
  syncLogs SyncLog[]
  products Product[]

  @@unique([platform, externalId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Dados sincronizados dos marketplaces
// ---------------------------------------------------------------------------

model Order {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  externalId String
  status     String
  currency   String   @default("BRL")
  gross      Float    @default(0) // valor bruto do pedido
  /// Total retido pelo marketplace. Redundante com a quebra abaixo de
  /// propósito: é o que alimenta o agregado diário sem precisar somar tudo.
  fees       Float    @default(0)
  itemsCount Int      @default(0)
  buyerRef   String?
  placedAt   DateTime
  raw        String? // payload original (JSON)

  // Quebra do que o marketplace reteve. Cada plataforma usa um subconjunto:
  // o ML cobra comissão e frete; a Shopee soma taxa de serviço e de cartão.
  commission Float @default(0) // comissão sobre a venda
  shipping   Float @default(0) // frete pago pelo vendedor
  serviceFee Float @default(0) // taxa de serviço (Shopee)
  cardFee    Float @default(0) // taxa de cartão de crédito
  /// Crédito, não custo: entra somando no líquido (moedas/cashback da Shopee).
  coins      Float @default(0)

  /// Como foi enviado — "Mercado Envios", "Full", "Shopee Xpress".
  shippingMode String?

  /// Comprador, quando a venda é do canal próprio/atacado em vez do marketplace.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items OrderItem[]

  @@unique([accountId, externalId])
  @@index([accountId, placedAt])
}

/// Linha de um pedido. É aqui que lucro e margem são calculados: o pedido
/// inteiro pode fechar no azul enquanto um item específico dá prejuízo, e é
/// esse item que o lojista precisa enxergar.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Nulo quando o anúncio não foi casado com nenhum produto do cadastro —
  /// sem isso não há custo, e portanto não há margem. É o que a tela avisa
  /// como "venda sem produto vinculado".
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  externalItemId String
  sku            String?
  title          String
  quantity       Int     @default(1)
  unitPrice      Float   @default(0)
  total          Float   @default(0)
  /// Parte da retenção do marketplace que cabe a esta linha.
  fees           Float   @default(0)

  @@index([orderId])
  @@index([productId])
}

/// Anúncio/produto da loja — a base da tela de estoque.
model Product {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  externalId String
  sku        String?
  title      String
  price      Float    @default(0)
  currency   String   @default("BRL")
  stock      Int      @default(0)
  status     String   @default("active") // active | paused | closed
  imageUrl   String?
  permalink  String?
  soldCount  Int      @default(0)
  syncedAt   DateTime @default(now())

  /// SYNCED = veio do marketplace (o sync manda nele).
  /// MANUAL = criado aqui dentro; o sync não sobrescreve nem apaga.
  origin String @default("SYNCED")

  /// Quanto custa para você adquirir uma unidade. Não vem de API nenhuma —
  /// é o lojista que informa, e sem ele não existe lucro nem margem.
  cost Float @default(0)

  /// Custo por unidade que não é o produto em si: embalagem, etiqueta, brinde.
  extraCost Float @default(0)

  /// Preço e pedido mínimo do canal de atacado. Criados pelo time no banco;
  /// nosso código ainda não os usa, mas precisam estar aqui — schema que não
  /// descreve o banco transforma `db push` numa armadilha.
  wholesalePrice  Float?
  wholesaleMinQty Int    @default(1)

  /// Identificadores da plataforma necessários para escrever estoque de volta
  /// (model_id da Shopee, sku_id + warehouse_id do TikTok). JSON.
  meta String?

  movements         StockMovement[]
  orderItems        OrderItem[]
  marketComparisons MarketComparison[]

  @@unique([accountId, externalId])
  @@index([accountId, stock])
}

/// Livro-caixa do estoque: toda entrada/saída fica registrada com autor e motivo.
model StockMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Positivo = entrada, negativo = saída.
  delta       Int
  stockBefore Int
  stockAfter  Int
  reason      String // COMPRA | VENDA | AJUSTE | PERDA | DEVOLUCAO
  note        String?

  authorId   String?
  authorName String

  /// Se o estoque foi propagado para o marketplace.
  pushed    Boolean @default(false)
  pushError String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model DailyMetric {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  day      DateTime
  revenue  Float    @default(0)
  orders   Int      @default(0)
  units    Int      @default(0)
  adsSpend Float    @default(0)
  fees     Float    @default(0)
  visits   Int      @default(0)

  @@unique([accountId, day])
  @@index([day])
}

model SyncLog {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  kind      String // orders | metrics | token_refresh | ads
  ok        Boolean
  message   String?
  itemCount Int       @default(0)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([accountId, startedAt])
}

/// Preço de um concorrente encontrado para um produto seu, na MESMA
/// plataforma. Usado por Shopee e TikTok Shop, que não têm API pública de
/// busca — os dados vêm de busca na web e são ESTIMATIVA, ao contrário do
/// Mercado Livre, cujo preço vem exato da API oficial e nem passa por aqui.
///
/// Persistido em vez de consultado a cada abertura de tela por dois motivos:
/// a busca leva ~26s (não cabe numa renderização) e cada uma custa dinheiro.
model MarketComparison {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Copiado de product.account.platform na criação — trava a comparação na
  /// mesma plataforma do anúncio.
  platform String

  competitorSeller String
  competitorTitle  String
  competitorPrice  Float
  competitorUrl    String?
  note             String?

  /// Trecho da página de onde o preço foi lido. Guardado para auditoria: dá
  /// para conferir depois de onde saiu cada número.
  sourceExcerpt String?

  authorId   String?
  authorName String

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/// Contador de tentativas de login para o rate limit.
///
/// Uma linha por chave, onde chave é `ip:<endereço>` ou `email:<e-mail>`. Fica
/// no banco, não em memória: em serverless cada requisição pode cair numa
/// instância diferente, e um contador em RAM zera a cada cold start — não
/// limitaria nada.
model LoginAttempt {
  key          String    @id
  attempts     Int       @default(0)
  /// Início da janela corrente. Passou da janela, o contador recomeça.
  windowAt     DateTime  @default(now())
  /// Preenchido quando estourou o limite; até lá, o login é recusado.
  blockedUntil DateTime?

  @@index([blockedUntil])
}

// Guarda o state/PKCE do OAuth entre o /start e o /callback
model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  platform  String
  clientId  String?
  verifier  String? // PKCE (Mercado Livre)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Módulos construídos por outra pessoa do time
//
// Estes modelos existem no banco e ainda não têm tela no nosso código. Estão
// declarados aqui por um motivo prático: `prisma db push` faz o banco espelhar
// este arquivo, então tudo que não estivesse descrito seria APAGADO no primeiro
// push — cinco tabelas e as colunas de atacado junto.
// ---------------------------------------------------------------------------

/// Cliente final e fornecedor do lojista (`kind`), fora dos marketplaces.
model Customer {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind     String  @default("CLIENTE")
  name     String
  document String?
  email    String?
  phone    String?
  city     String?
  uf       String?
  notes    String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  financeEntries FinanceEntry[]

  @@index([clientId, kind])
}

/// Lançamento financeiro avulso — o que entra e sai fora do repasse do
/// marketplace (despesa operacional, receita extra, conta a pagar).
model FinanceEntry {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind        String
  category    String
  description String
  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  method      String?
  platform    String?
  recurring   Boolean   @default(false)
  notes       String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  orderId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, kind, dueDate])
}

/// Atendimento com o comprador, por marketplace.
model Conversation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  platform       String
  customerName   String
  customerHandle String?
  status         String   @default("ABERTA")
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  messages Message[]

  @@index([clientId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction String
  body      String
  sentAt    DateTime  @default(now())
  readAt    DateTime?

  @@index([conversationId, sentAt])
}

/// Preferências por empresa. Substitui as constantes espalhadas no código —
/// `taxRate` é a alíquota que hoje vive fixa em TAX_RATE, e `lowStockThreshold`
/// o que está em LOW_STOCK.
model Settings {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  companyName String?
  document    String?
  phone       String?
  address     String?

  taxRate           Float   @default(0.113)
  defaultExtraCost  Float   @default(0)
  lowStockThreshold Int     @default(5)
  notifyLowStock    Boolean @default(true)
  notifyFinance     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cobrança
// ---------------------------------------------------------------------------

/// Assinatura do lojista. Uma por Client, porque o acesso é um login por
/// empresa. Os campos de status espelham o Stripe de propósito: o Stripe é a
/// fonte da verdade sobre quem pagou, e este registro é um cache local para
/// não consultar a API deles a cada carregamento de página.
model Subscription {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// "BASICO" | "PRO" — a lista vale em src/lib/plans.ts.
  plan String @default("BASICO")

  /// "trialing" | "active" | "past_due" | "canceled" | "incomplete".
  /// Só `trialing` e `active` liberam o sistema.
  status String @default("trialing")

  /// Fim do teste grátis. Enquanto estiver no futuro, libera tudo sem cartão.
  trialEndsAt DateTime?

  /// Fim do período já pago. É a data que decide o corte quando a renovação
  /// falha: o lojista continua entrando até aqui, não até o dia da recusa.
  currentPeriodEnd DateTime?

  /// Cancelou, mas segue com acesso até o fim do período que já pagou.
  cancelAtPeriodEnd Boolean @default(false)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Eventos do Stripe já processados.
///
/// O Stripe reentrega o mesmo evento quando não recebe 200 depressa, e a ordem
/// de chegada não é garantida. Sem esta trava, uma reentrega de
/// `invoice.paid` poderia estender o período duas vezes — ou pior, um evento
/// antigo chegando atrasado rebaixaria um plano que já foi elevado.
model WebhookEvent {
  /// O próprio `event.id` do Stripe: a chave de idempotência vem deles.
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Recuperação de senha
// ---------------------------------------------------------------------------

/// Pedido de "esqueci minha senha".
///
/// Guardamos **só o hash** do token, nunca ele mesmo: quem lesse o banco
/// poderia trocar a senha de qualquer conta se o valor estivesse em claro —
/// seria uma segunda porta de entrada, tão boa quanto a senha.
model PasswordReset {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Marcado no primeiro uso: o link vale uma vez só.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
