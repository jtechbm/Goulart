# ---------------------------------------------------------------------------
# JtechERP — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

# Banco. Dev = SQLite. Produção: troque o provider em prisma/schema.prisma
# para "postgresql" e use algo como postgresql://user:pass@host:5432/jtecherp
DATABASE_URL="file:./dev.db"

# URL pública da app — usada para montar os redirect_uri do OAuth.
# Precisa bater EXATAMENTE com o que você cadastrou em cada plataforma.
APP_URL="http://localhost:3000"

# Chave AES-256-GCM (base64, 32 bytes) que cifra os tokens no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Segredo usado para autenticar chamadas ao endpoint de sync (cron).
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Mercado Livre — https://developers.mercadolivre.com.br/devcenter
# Redirect URI a cadastrar: {APP_URL}/api/oauth/mercadolivre/callback
# Obs.: o redirect_uri do ML precisa ser HTTPS (use um túnel em dev).
# ---------------------------------------------------------------------------
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
# Domínio de auth conforme o país do vendedor (MLB = Brasil)
ML_AUTH_DOMAIN="https://auth.mercadolivre.com.br"

# ---------------------------------------------------------------------------
# Shopee Open Platform — https://open.shopee.com
# Redirect URI a cadastrar: {APP_URL}/api/oauth/shopee/callback
# ---------------------------------------------------------------------------
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
# Sandbox: https://partner.test-stable.shopeemobile.com
# Produção: https://partner.shopeemobile.com
SHOPEE_HOST="https://partner.test-stable.shopeemobile.com"

# ---------------------------------------------------------------------------
# TikTok Shop Partner Center — https://partner.tiktokshop.com
# Redirect URI (Callback URL do app): {APP_URL}/api/oauth/tiktok/callback
# ---------------------------------------------------------------------------
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
# service_id do app, usado na URL de autorização
TIKTOK_SERVICE_ID=""
TIKTOK_AUTH_HOST="https://services.tiktokshop.com"
TIKTOK_TOKEN_HOST="https://auth.tiktok-shops.com"
TIKTOK_API_HOST="https://open-api.tiktokglobalshop.com"
